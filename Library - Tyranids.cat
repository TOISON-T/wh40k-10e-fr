        <selectionEntryGroup name="Legendary Relics" id="cd6a-1f77-7694-4573" hidden="false" sortIndex="3">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="The Norn Crown" hidden="false" id="9b41-9d3a-0922-4ba7">
              <profiles>
