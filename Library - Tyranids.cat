          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Primary Detonator" hidden="false" id="9c6d-1f1f-45ea-fe5b">
              <profiles>
                <profile name="Primary Detonator" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="66be-e539-7616-2db1">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Une fois par bataille, lorsqu'une unité ennemie ouvre une porte fermée, si le porteur est sur le champ de bataille, il peut utiliser cette augmentation. Si c'est le cas, lancez un D6: sur un 3-4, cette unité ennemie subit 1 blessure mortelle; sur un 5+, cette unité ennemie subit 2 Blessures Mortelles.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="and">
