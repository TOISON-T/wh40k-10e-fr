  <sharedProfiles>
    <profile name="Damaged: 1-4 Wounds Remaining" hidden="false" id="b4a8-7659-cc29-b18e" typeName="Abilities" typeId="9cc3-6d83-4dd3-9b64">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Tant que cette figurine a 1-4 PV restants, chaque fois qu’elle effectue une attaque, soustrayez 1 au jet de Touche.</characteristic>
      </characteristics>
    </profile>
    <profile id="384f-e5ff-31a2-1295" name="Damaged: 1-5 Wounds Remaining" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Tant que cette figurine a 1-5 PV restants, chaque fois qu’elle effectue une attaque, soustrayez 1 au jet de Touche.</characteristic>
      </characteristics>
    </profile>
    <profile id="50cc-aa66-ffc8-61c7" name="Damaged: 1-6 Wounds Remaining" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Tant que cette figurine a 1-6 PV restants, chaque fois qu’elle effectue une attaque, soustrayez 1 au jet de Touche.</characteristic>
      </characteristics>
    </profile>
    <profile name="Will of the Hive Mind" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="13-98c1-d481-eb95">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Une fois par tour de bataille, une figurine de votre armée avec cette aptitude peut l'utiliser quand une unité amicale **^^Tyranids^^** à 12" ou moins de cette figurine est ciblé avec un Stratagème. Si c'est le cas, réduisez le coût CP de cette utilisation de ce Stratagème par 1CP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Feeder Tendrils" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3f46-6dbb-d99b-4ae2">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Chaque fois que cette figurine détruit une figurine de personnage ennemi, vous gagnez 1CP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Chitinous Horrors (Aura)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="533-9226-7e51-ee0">
      <characteristics>
        <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Alors qu'une unité ennemie se trouve dans la Portée d’Engagement de cette unité, réduisez de moitié la caractéristique de Contrôle d’Objectif des figurines de cette unité ennemie.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ripper Swarm" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="fdd3-f5cd-d338-974c">
      <characteristics>
        <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6"</characteristic>
