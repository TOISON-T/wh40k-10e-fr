              </constraints>
              <profiles>
                <profile id="e43b-68a7-4d07-e707" name="Enraged Reserves" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids Monster^^** uniquement. Si le porteur est détruit par une attaque de mêlée, s'il n'a pas combattu cette phase, lancez un D6: sur un 3+, ne le retirez pas du jeu. Il peut se battre après que l'unité de la figurine attaquant ait terminé ses attaques, et est ensuite retiré du jeu.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
