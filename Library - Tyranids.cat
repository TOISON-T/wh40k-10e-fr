            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0" />
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0" />
          </costs>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="4129-a453-686a-d38a" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="4129-a453-686a-d38a" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Casts No Shadow" hidden="false" id="9b1e-095e-fa33-228e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="07c6-f045-a97b-94a5" includeChildSelections="false" />
          </constraints>
          <profiles>
            <profile name="Casts No Shadow" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ceee-55f8-0cee-b05a">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Tant que cette unité possède cette Cicatrice de Bataille, elle est affectée par l’aptitude Shadow in the Warp de votre armée (et doit donc effectuer un test d’Ébranlement lorsque cette aptitude est utilisée).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0" />
            <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="-1" />
            <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0" />
            <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0" />
          </costs>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="4129-a453-686a-d38a" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="4129-a453-686a-d38a" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Detachment" hidden="false" id="7170-c243-d89f-6644" defaultSelectionEntryId="none">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Host of Ascension" hidden="false" id="0a79-5968-68f0-56b5">
          <infoLinks>
            <infoLink name="Ignore le couvert" id="d4eb-1f63-596f-0248" hidden="false" type="rule" targetId="4640-43e7-30b-215a" />
            <infoLink name="Touches soutenues" id="6890-0ca1-a2b2-0c1e" hidden="false" type="rule" targetId="1897-c22c-9597-12b1" />
          </infoLinks>
          <rules>
            <rule name="A Perfect Ambush" id="8214-2942-7876-9ce9" hidden="false">
              <description>Chaque fois qu'une unité Genestealer CULTS de votre armée est mise en place sur le champ de bataille comme Renforcements, jusqu'à la fin de votre prochaine phase de Combat, les armes équipées par des figurines dans cette unité ont les capacités [Touches soutenues 1] et [Ignore le couvert]</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Xenocreed Congregation" hidden="false" id="536a-b3ea-7597-81bb">
          <infoLinks>
            <infoLink name="Insensible à la douleur" id="625a-19a0-4136-54d7" hidden="false" type="rule" targetId="9bf4-280f-bbe2-6fbb" />
          </infoLinks>
          <rules>
            <rule name="Unquestioning Fanaticism" id="d2bd-ec2b-d13f-7a0f" hidden="false">
              <description>Pour chaque unité ACOLYTE HYBRIDS, Hybrid Metamorphs, et Neophyte Hybrid de votre armée, alors qu'une ou plusieurs figurines CHARACTER sont à la tête de cette unité, vous pouvez relancer des jets d’Avance et de Charge faits pour elle. Si cette figurine CHARACTER est un Magus, Primus ou Acolyte Iconward, cette figurine a la aptitude Insensible à la douleur 3+ tout en conduisant cette unité.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Biosanctic Broodsurge" hidden="false" id="ff11-0fa4-2950-380e">
          <rules>
            <rule name="Hypermorphic Fury" id="0a4d-88d1-161e-213b" hidden="false">
              <description>Ajoutez 1 aux jets de Charge faits pour les unités **^^Aberrants^^**, **^^Biophagus^^** et **^^Purestrain Genestealers^^** de votre armée. En outre, chaque fois qu'une telle unité est sélectionnée pour combattre, si elle effectuer un mouvement de Charge à ce tour, jusqu'à la fin de la phase, ajoutez 1 aux caractéristique d’Attaques des armes de mêlée équipées par les figurines de cette unité.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Outlander Claw" hidden="false" id="59e2-4fec-2b00-b1e8">
          <rules>
            <rule name="Rapid Takeover" id="55fe-5524-6833-4196" hidden="false">
              <description>Bien qu'une figurine Genestealer CULTS MOUNTED ou Genestealer CULTS VEHICLE de votre armée ne soit pas Ébranlé, ajoutez 1 à sa caractéristique de Contrôle d’Objectif. En outre, à la fin de votre phase de Commandement, si une ou plusieurs unités Atalan Jackals de votre armée sont à portée d'un marqueur objectif que vous contrôlez, ce marqueur objectif reste sous votre contrôle jusqu'à ce que le niveau de contrôle de votre adversaire sur ce marqueur objectif soit supérieur à la vôtre à la fin d'une phase.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Brood Brother Auxilia" hidden="false" id="0a59-1d64-257c-04fb">
          <rules>
            <rule name="Brood Brothers" id="fc33-afdd-30e9-47b1" hidden="false">
              <description>Vous pouvez inclure des unités **^^Astra Militarum^^** dans votre armée, même si elles n'ont pas le mot-clé **^^Genestealer Cult^^** Faction. Le coût combiné de ces unités que vous pouvez inclure dans votre armée est:

- Incursion: jusqu'à 500 pts
- Strike Force: jusqu’à 1000 pts
- Onslaught: jusqu’à 1500 pts

une figurine **^^Genestealer Cult^^** doit être votre Warlord, et les figurines **^^Astra Militarum^^** de votre armée perdent la aptitude de Voice Of Command s'ils l'ont. Vous ne pouvez pas inclure des unités avec l'un des mots clés suivants dans votre armée en utilisant cette règle: **^^Aircraft^^**; **^^Commisar^^**; **^^Epic Hero^^**; **^^Militarum Tempestus^^**; **^^Ogryn^^**; **^^Ratling^^**; **^^Tech-Priest Enginseer^^**; **^^Ministorum Priest^^**.</description>
            </rule>
            <rule name="Integrated Tactics" id="2ac6-4080-aea3-847e" hidden="false">
              <description>Chaque fois qu'une unité **^^Astra Militarum^^** de votre armée est sélectionnée pour tirer, vous pouvez sélectionner une unité ennemi à 18" ou moins et visible à cette unité. Si vous le faites, jusqu'à la fin de la phase, les figurines de cette unité **^^Astra Militarum^^** ne peuvent cibler que cette unité ennemie (et seulement si c'est une cible admissible) et que cette unité ennemie est prise dans le feu qui se chevauchent. Alors qu'une unité ennemie est prise dans le feu qui se chevauchent, chaque fois qu'une figurine **^^Genestealer Cult^^** de votre armée cible cette unité ennemie avec une attaque de tir, ajoutez 1 à le jet de Touche.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Final Day" hidden="false" id="cb2f-554e-1162-75d5">
          <rules>
            <rule name="The Star Children's Blessings" id="a351-e932-e0b3-2ed7" hidden="false">
              <description>Vous pouvez inclure dans votre armée des unités TYRANIDS VANGUARD INVADER (à l'exclusion des unités AIRCRAFT, Broodlord et Genestealers). Le coût combiné de ces unités dépend de la taille de la bataille:

■ Incursion: jusqu'à 500 pts
■ Strike Force: jusqu’à 1000 pts
■ Onslaught: jusqu’à 1500 pts

aucune figurine TYRANIDS de votre armée ne peut être votre WARLORD.</description>
            </rule>
            <rule name="Psionic Parasitism" id="8db4-851f-477e-325e" hidden="false">
              <description>À la fin de votre phase de Mouvement, pour chaque unité TYRANIDS SYNAPSE de votre armée, vous pouvez sélectionner une unité GENESTEALER CULTS amie (à l’exclusion des unités PURESTRAIN GENESTEALER et PATRIARCH) et une unité TYRANIDS amie, chacune à 9" ou moins de cette unité SYNAPSE et visible de celle-ci. Si vous le faites, cette unité GENESTEALER CULTS de votre armée subit D3+1 blessures mortelles, une figurine de l’unité TYRANIDS sélectionnée récupère jusqu’à ce nombre de PV perdus et, jusqu’au début de votre prochaine phase de Mouvement, chaque fois qu’une figurine de l’unité TYRANIDS sélectionnée effectue une attaque, ajoutez 1 au jet de Touche.

Les unités TYRANIDS de votre armée ont l’aptitude suivante :

Catalyst (Aura): Tant qu’une unité ennemie est à 6" ou moins de cette unité, chaque fois qu’une unité GENESTEALER CULTS amie effectue une attaque qui cible cette unité ennemie, ajoutez 1 au jet de Touche.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Cult Unveiled" hidden="false" id="24fc-8c17-7d50-bec9">
          <comment>Boarding Actions</comment>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Forming Boarding Squads" id="d7ac-9b05-c811-76eb" hidden="false">
              <description>Ne divisez pas ^^**Neophyte Hybrids**^^ en unités distinctes dans l'étape des escadrons d'embarquement du formulaire.</description>
            </rule>
            <rule name="Mustering A Boarding Patrol" id="e802-74a2-7034-c9c0" hidden="false">
              <description>Vous pouvez inclure jusqu'à l'une des unités suivantes:
- **^^Magus^^**
- **^^Primus^^**

Vous pouvez inclure jusqu'à deux des unités suivantes (les duplicats ne sont pas autorisés):
- **^^Acolyte Iconward^^**
- **^^Clamavus^^**
- **^^Kelermorph^^**
- **^^Locus^^**
- **^^Sanctus^^**

Vous pouvez inclure jusqu'à trois des unités suivantes:
- Les figurines **^^Acolyte Hybrids with Autopistols^^** (5 ou 10)
- Pour les figurines **^^Neophyte Hybrids^^** (figurines 10)

Vous pouvez inclure jusqu'à l'une des unités suivantes:
- Les figurines **^^Acolyte Hybrids with Hand Flamers^^** (5 ou 10)</description>
            </rule>
            <rule name="Rules Adaptions" id="15ac-afc2-87aa-eaa7" hidden="false">
              <description>- Les unités **^^Genestealer Cults^^** perdent l’aptitude Frappe en profondeur.
- L’unité **^^Acolyte Hybrids with Autopistols^^** perd l’aptitude Claimed for the Cult.
- La figurine **^^Acolyte Iconward^^** perd l’aptitude Summon the Cult.
- L’unité **^^Neophyte Hybrids^^** perd l’aptitude A Plan Generations in the Making.
- La figurine **^^Primus^^** perd l’aptitude Decoys and Misdirection.</description>
            </rule>
            <rule name="Harassing Fire" id="45a4-7a75-b404-4be2" hidden="false">
              <description>À la fin de votre phase de Tir, vous pouvez sélectionner une unité **^^Genestealer Cults^^** de votre armée qui n'est pas dans la Portée d’Engagement d'une ou plusieurs unités ennemies. Si vous le faites, cette unité peut essayer d'opérer un Hatchway ouvert il est à 1" ou moins de (s'il y en a un), et peut ensuite faire un déplacement normal jusqu'à 3" (indépendamment de s'il a tenté d'opérer un Hatchway ou non). Jusqu'à la fin du tour, cette unité n'est pas éligible à la déclaration d'une charge.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink targetId="4c34-1bd0-8565-fd5a" id="dd8c-45c0-b26f-6fc2" type="rule" name="Insidious Ambushers" hidden="false" />
          </infoLinks>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Genespawn Onslaught" hidden="false" id="be7f-de0b-6659-198a">
          <comment>Boarding Actions</comment>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Mustering A Boarding Patrol" id="329e-430a-c60b-a190" hidden="false">
              <description>Vous pouvez inclure jusqu'à deux des unités suivantes (les duplicats ne sont pas autorisés):
- **^^Abominant^^**
- **^^Benefictus^^**
- **^^Biophagus^^**

Vous pouvez inclure jusqu'à deux des unités suivantes:
- Les figurines **^^Aberrants^^** (5 ou 10)

Vous pouvez inclure jusqu'à l'une des unités suivantes:
- Les figurines **^^Hybrid Metamorphs^^** (5 ou 10)</description>
            </rule>
            <rule name="Rules Adaptions" id="2944-4f78-48d1-6626" hidden="false">
              <description>- Les unités **^^Genestealer Cults^^** perdent l’aptitude Frappe en profondeur.
- L’unité **^^Hybrid Metamorphs^^** perd l’aptitude Brood Surge.</description>
            </rule>
            <rule name="Blessed Visages" id="5389-de27-ddda-bd2a" hidden="false">
              <description>Chaque fois qu'une unité ennemie déclare une charge qui vise une ou plusieurs unités **^^Genestealer Cults^^** de votre armée, cette unité ennemie doit passer un test de Commandement. En cas d'échec, jusqu'à la fin du tour, chaque fois qu'une figurine de l'unité ennemie effectue une attaque, Soustrayez 1 du jet de Touche.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink targetId="4c34-1bd0-8565-fd5a" id="7f97-5a65-3cb8-d131" type="rule" name="Insidious Ambushers" hidden="false" />
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0fc5-7bb0-0193-6f30-min" includeChildSelections="false" />
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0fc5-7bb0-0193-6f30-max" includeChildSelections="false" />
      </constraints>
      <comment>Genestealer Cults</comment>
      <entryLinks>
        <entryLink import="true" name="Infestation Swarm" hidden="false" id="b9a2-7c0b-93f9-ad86" targetId="24e1-c66e-98e9-135b" type="selectionEntry">
          <comment>Boarding Actions - Great Devourer</comment>
        </entryLink>
      </entryLinks>
    </selectionEntryGroup>
    <selectionEntryGroup name="Ability" id="3e82-2186-c604-2a76" hidden="false" defaultSelectionEntryId="none">
      <comment>Crucible content</comment>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Synaptic Senses (Psychic)" hidden="false" id="dd87-da9a-0624-4b1c">
          <profiles>
            <profile name="Synaptic Senses (Psychic)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e13c-5912-365f-393f">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Psyker^^** uniquement. Les armes de tir équipées par des figurines de cette unité ont la aptitude **[LETHAL HITS]**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="root-entry" childId="13bf-2bee-3ae0-b414" shared="true" />
              </conditions>
            </modifier>
          </modifiers>
          <infoLinks>
            <infoLink name="Touches fatales" id="bbff-5224-3ed0-254b" hidden="false" type="rule" targetId="d1d1-611e-5191-1095" />
          </infoLinks>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Fear of the Unseen (Aura)" hidden="false" id="7d90-bb45-94c5-7f5a">
          <profiles>
            <profile name="Fear of the Unseen (Aura)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b039-9aad-9f60-4284">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Alors qu'une unité ennemie est à 6" ou moins de cette figurine, aggraver la caractéristique de Commandement des figurines dans cette unité par 1. En outre, dans la étape d’Ébranlement de la phase de Commandement de votre adversaire, si une telle unité ennemie est inférieure à son Effectif Initial, elle doit passer un test d’Ébranlement.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Feeder Tendrils" hidden="false" id="92da-77b6-61f7-53d8">
          <profiles>
            <profile name="Feeder Tendrils" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4aa3-3cd3-7336-41b2">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Chaque fois qu'une attaque de mêlée fait une figurine dans cette unité détruit une figurine ennemie **^^Character^^**, vous gagnez 1CP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hyperstimulation" hidden="false" id="32a6-d923-5891-cd58">
          <profiles>
            <profile name="Hyperstimulation" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="b495-00ed-3380-4286">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Vous pouvez relancer les jets d’Avance et de Charge faits pour cette unité.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Psychic Terror (Psychic)" hidden="false" id="542b-4051-669a-7314">
          <profiles>
            <profile name="Psychic Terror (Psychic)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8a42-30ba-a38d-d784">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Psyker^^** uniquement. Si une ou plusieurs figurines de votre armée dotées de cette aptitude sont sur le champ de bataille lorsque vous déclenchez Shadow in the Warp, soustrayez 1 au test d’Ébranlement que chaque unité ennemie sur le champ de bataille doit effectuer en conséquence.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="root-entry" childId="13bf-2bee-3ae0-b414" shared="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="452d-863f-71ed-fa9f" includeChildSelections="false" />
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8fd9-9bf8-a4cd-e7cc" includeChildSelections="false" />
      </constraints>
    </selectionEntryGroup>
    <selectionEntryGroup name="Specialisms" id="9c71-7661-3b6b-a27c" hidden="false">
      <comment>Crucible content</comment>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Burrowing Claws" hidden="false" id="0afb-d2ae-1373-773e">
          <profiles>
            <profile name="Burrowing Claws" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="91e6-f97e-a0e4-b1d8">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Modifiez la caractéristique de mouvement de cette figurine à 10", ajoutez le mot-clé **^^Vanguard Invader^^**, et il obtient la aptitude Frappe en profondeur. S'il s'agit d'une figurine **^^Infantry^^**, remplacez la liste des unités auxquelles cette figurine peut être attachée: **^^Raveners^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="set" value="10&quot;" field="e703-ecb6-5ce7-aec1" scope="root-entry" affects="profiles.Unit" />
                <modifier type="append" value="Burrowing Claws" field="annotation" scope="root-entry" affects="profiles.Unit" join=", " />
                <modifier type="add" value="5ff0-d52d-e2b8-9de" field="category" scope="root-entry" />
              </modifiers>
            </modifierGroup>
          </modifierGroups>
