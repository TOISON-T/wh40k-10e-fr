          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Psi-spoor Sensitivity" hidden="false" id="8f01-371b-ea62-40fc">
              <profiles>
                <profile name="Psi-spoor Sensitivity" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="9079-c8a9-bf58-6fa6">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Chaque fois que le porteur déclare une charge, il peut cibler les unités ennemies qui ne sont pas visibles pour lui.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="8f01-371b-ea62-40fc" shared="true" includeChildForces="true" includeChildSelections="true" />
                        <condition type="lessThan" value="1" field="selections" scope="parent" childId="8f01-371b-ea62-40fc" shared="true" includeChildForces="true" includeChildSelections="true" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <categoryLinks>
                <categoryLink name="Grenades" hidden="false" id="29fc-6a4b-fe2d-2355" targetId="5a61-81ac-eb7c-a87e" primary="false" />
              </categoryLinks>
              <costs>
                <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0" />
                <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0" />
                <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0" />
                <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0" />
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0" />
                <cost name="Diplomatic Power" typeId="4d7c-04b6-8a79-837f" value="0" />
                <cost name="Military Power" typeId="1cbe-d9c9-86a8-2d41" value="0" />
              </costs>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="339e-604f-cc55-e2d2" includeChildForces="true" includeChildSelections="true" />
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Stalking Menace" hidden="false" id="916b-b065-5189-7ee6">
              <profiles>
                <profile name="Stalking Menace" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="691e-ff09-c323-9840">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Une fois par bataille, à la fin de la phase de Combat de votre adversaire, si le porteur n'est pas dans la Portée d’Engagement d'une ou de plusieurs unités ennemies, il peut utiliser ce renforcement. Si c'est le cas, retirez le porteur du champ de bataille et placez-le dans les réserves stratégiques. Il reviendra sur le champ de bataille dans la phase de renforcement de votre prochaine phase de Mouvement comme s'il avait la aptitude Frappe en profondeur. Si cela n'est pas possible, le porteur est détruit. Lorsque le porteur est remis sur le champ de bataille, jusqu'à la fin du tour, il ne peut pas déclarer une charge.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="916b-b065-5189-7ee6" shared="true" includeChildForces="true" includeChildSelections="true" />
                        <condition type="lessThan" value="1" field="selections" scope="parent" childId="916b-b065-5189-7ee6" shared="true" includeChildForces="true" includeChildSelections="true" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <categoryLinks>
                <categoryLink name="Grenades" hidden="false" id="51ee-0d5c-a897-8b06" targetId="5a61-81ac-eb7c-a87e" primary="false" />
              </categoryLinks>
              <costs>
                <cost name="Crusade Points" typeId="b03b-c239-15a5-da55" value="0" />
                <cost name="Crusade: Battle Honours" typeId="75bb-ded1-c86d-bdf0" value="0" />
                <cost name="Crusade: Experience" typeId="a623-fe74-1d33-cddf" value="0" />
                <cost name="Crusade: Weapon Modifications" typeId="716d-91b7-d55a-1022" value="0" />
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0" />
                <cost name="Diplomatic Power" typeId="4d7c-04b6-8a79-837f" value="0" />
                <cost name="Military Power" typeId="1cbe-d9c9-86a8-2d41" value="0" />
              </costs>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1727-4a39-c1dc-5c17" includeChildForces="true" includeChildSelections="true" />
              </constraints>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <modifiers>
        <modifier type="set" value="-1" field="4856-7562-fc89-349b">
          <conditions>
            <condition type="atLeast" value="1" field="forces" scope="roster" childId="cac3-71d1-ea4b-795d" shared="true" includeChildSelections="true" includeChildForces="true" />
          </conditions>
        </modifier>
      </modifiers>
      <entryLinks>
        <entryLink import="true" name="Boarding Actions Enhancements" hidden="false" id="3387-f5ff-d9ec-b8a9" type="selectionEntryGroup" targetId="5a79-2c0b-66e4-2122">
          <comment>Boarding Actions content</comment>
        </entryLink>
        <entryLink import="true" name="Breaching Operation Enhancements" hidden="false" id="f53d-a37c-851d-d22f" type="selectionEntryGroup" targetId="fc3b-5a53-47b1-4b2d">
          <comment>Boarding Actions content</comment>
        </entryLink>
      </entryLinks>
    </selectionEntryGroup>
    <selectionEntryGroup id="7ada-e361-1f7e-af" name="Detachment" hidden="false" collective="false" import="true" defaultSelectionEntryId="none">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9771-9344-412d-6850" type="min" />
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="932-a6c9-b917-9279" type="max" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="c2fe-bf23-bf24-aa43" name="Invasion Fleet" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0" />
          </costs>
          <rules>
            <rule name="Hyper Adaptions" id="9faa-bec0-9a4e-901e" hidden="false">
              <description>Au début du premier tour de bataille, sélectionnez l'une des hyper-adaptations suivantes pour être active pour les unités **^^Tyranids^^** de votre armée jusqu'à la fin de la bataille:

**SWARMING INSTINCTS**
Chaque fois qu'une figurine **^^Tyranids^^** avec cette hyper-adaptation effectue une attaque qui cible une unité ennemie **^^Infantry^^** ou **^^Swarm^^**, cette attaque a la aptitude **[SUSTAINED HITS 1]**.

**HYPER-AGGRESSION**
Chaque fois qu'une figurine **^^Tyranids^^** avec cette hyper-adaptation effectue une attaque qui cible une unité ennemie **^^Monster^^** ou **^^Vehicle^^**, cette attaque a la aptitude **[LETHAL HITS]**.

**HIVE PREDATORS**
Chaque fois qu'une figurine **^^Tyranids^^** avec cette hyper-adaptation effectue une attaque qui cible une unité **^^Character^^** ennemie, si un Hit critique est marqué, cette attaque a la aptitude **[PRECISION]**.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink name="Touches soutenues" id="e445-0a10-8fd8-7a27" hidden="false" type="rule" targetId="1897-c22c-9597-12b1" />
            <infoLink name="Touches fatales" id="20ca-b606-4aa3-b402" hidden="false" type="rule" targetId="d1d1-611e-5191-1095" />
            <infoLink name="Précision" id="1d17-2d61-ae0b-44cf" hidden="false" type="rule" targetId="9143-31ae-e0a6-6007" />
          </infoLinks>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Assimilation Swarm" hidden="false" id="bba-65f6-a4d1-66ae">
          <rules>
            <rule name="Feed the Swarm" id="0442-1dce-2f22-5bbc" hidden="false">
              <description>Dans votre phase de Commandement, chaque unité **^^Harvester^^** de votre armée peut régénérer une unité **^^Tyranids^^** amicale qui est à 6" ou moins. Une unité ne peut être régénérée qu'une seule fois par phase. Chaque fois qu'une unité se régénère, effectue l'une des opérations suivantes:

- une figurine dans cette unité récupère jusqu'à D3+1 PV perdus
- une figurine **^^Infantry^^** détruit (à l'exclusion de **^^Characters^^**) est renvoyé à cette unité avec ses blessures complètes. Si cette unité est une unité **^^Endless Multitude^^**, retourner jusqu'à 3 les figurines détruits sont retournés à la place.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Crusher Stampede" hidden="false" id="850e-bee1-4845-820d">
          <rules>
            <rule name="Enraged Behemoths" id="9e9a-b09f-1a55-1d27" hidden="false">
              <description>Chaque fois qu'une figurine **^^Tyranids Monster^^** de votre armée attaque, Ajoutez 1 au jet de Touche si l'unité de cette figurine est inférieure à son Effectif Initial, et Ajoutez 1 au jet de Blessure si l'unité de cette figurine est en dessous de son Demi-effectif. En outre, alors qu'une unité **^^Tyranids Monster^^** de votre armée (à l'exclusion des unités Ébranlées) est à son Effectif Initial, ajoutez 2 à la caractéristique de Contrôle d’Objectif des figurines de cette unité.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Synaptic Nexus" hidden="false" id="16ff-a068-4c31-285a">
          <rules>
            <rule name="Synaptic Imperitives" id="443e-6ef5-6bdd-e418" hidden="false">
              <description>Au début du tour de bataille, vous pouvez sélectionner l'un des impératifs synaptiques montrés ci-dessous. Jusqu'à la fin du tour de bataille, cet impératif synaptique est actif pour votre armée et pendant qu'une unité **^^Tyranids^^** de votre armée est dans la plage Synapse de votre armée, elle en bénéficiera. Chaque impératif synaptique ne peut être sélectionné qu'une seule fois par bataille.

- **Synaptic Augmentation:** Alors que cette unité est dans la plage Synapse de votre armée, les figurines dans cette unité ont un 5+ sauvegarde invulnérable.
- **Surging Vitality:** Alors que cette unité est dans la plage Synapse de votre armée, ajoutez 1 aux jets d’Avance et de Charge faits pour cette unité.
- **Goaded to Slaughter:** Alors que cette unité est dans la plage Synapse de votre armée, chaque fois qu'une figurine dans cette unité fait une attaque de mêlée, Ajoutez 1 à le jet de Touche</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Unending Swarm" hidden="false" id="4cd9-313f-cd9b-c85a">
          <rules>
            <rule name="Insurmountable Odds" id="fe2d-b32d-6e15-8523" hidden="false">
              <description>Chaque fois qu’une unité ennemie est sélectionnée pour tirer, après qu’elle a terminé toutes ses attaques, si une ou plusieurs figurines d’une ou plusieurs unités **^^Endless Multitude^^** de votre armée ont été détruites à la suite de ces attaques, chacune de ces unités peut effectuer un mouvement d’élan. Pour ce faire, lancez un D6 : cette unité peut être déplacée d’un nombre de pouces inférieur ou égal au résultat, mais doit terminer ce mouvement aussi près que possible de l’unité ennemie la plus proche (à l’exclusion des **^^Aircraft^^**). Dans ce cas, ces figurines peuvent être déplacées à Portée d’Engagement des unités ennemies. Une unité ne peut pas effectuer de mouvement d’élan tant qu’elle est Ébranlée</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Vanguard Onslaught" hidden="false" id="f773-f91c-2999-c7e1">
          <rules>
            <rule name="Vanguard Prime" id="299e-060b-6c02-ebb2" hidden="false">
              <description>**^^Deathleaper^^** perd la règle Hunter Organism et peut être votre **^^Warlord^^**.</description>
            </rule>
            <rule name="Questing Tendrils" id="8b66-9cf9-abae-c14c" hidden="false">
              <description>Les unités **^^Tyranids^^** dotées de cette aptitude sont éligibles pour déclarer une Charge durant un tour où elles ont Battu en Retraite. Les unités Vanguard Invader dotées de cette aptitude sont éligibles pour déclarer une Charge durant un tour où elles ont Avancé.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Warrior Bioform Onslaught" hidden="false" id="7416-b7cc-fdbf-5bf0">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Keywords" id="8eae-583e-e504-1241" hidden="false">
              <description>Les unités **^^Tyranid Warriors With Ranged Bio Weapons^^** et **^^Tyranid Warriors With Melee Bio Weapons^^** de votre armée obtiennent les mots clés **^^Tyranid Warriors^^** et **^^Battleline^^**, et bien qu'une telle unité ne soit pas Ébranlée, les figurines **^^Tyranid Warriors^^** de cette unité ont une caractéristique de Contrôle d’Objectif de 3.</description>
            </rule>
            <rule name="Leader-beasts" id="372a-a870-cbf9-05e4" hidden="false">
              <description>Les unités **^^Tyranid Warriors^^**, **^^Tyranid Prime with Lash Whip^^** et **^^Winged Tyranid Prime^^** de votre armée ont un 5+ sauvegarde invulnérable.</description>
            </rule>
          </rules>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="increment" value="1" field="bef7-942a-1a23-59f8" affects="self.entries.forces.recursive.e3d4-6430-ea62-8d6d.profiles.Unit" scope="roster" />
                <modifier type="append" value="Warrior Bioform Onslaught" field="annotation" affects="self.entries.forces.recursive.e3d4-6430-ea62-8d6d.profiles.Unit" scope="roster" join=", " />
              </modifiers>
            </modifierGroup>
          </modifierGroups>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Subterranean Assault" hidden="false" id="731f-1524-da02-945b">
          <rules>
            <rule name="Keywords" id="bdb0-bcca-2c70-32f3" hidden="false">
              <description>Les unités **^^Mawloc^^** et **^^Trygon^^** de votre armée ont le mot-clé Burrower.

Dans l'étape Muster Armies, vous pouvez sélectionner jusqu'à 2 **^^Trygon^^** figurines de votre armée. Les unités sélectionnées obtiennent le mot-clé **^^Character^^**.

**Designer’s Note:** *Cela signifie que les figurines sélectionnés peuvent recevoir des améliorations et que l'un d'entre eux peut être sélectionnées comme votre **^^Warlord^^**.</description>
            </rule>
            <rule name="Surprise Assault" id="e55b-01c2-96c1-8435" hidden="false">
              <description>Chaque fois qu’une figurine **^^Tyranids^^** de votre armée effectue une attaque, relancez un jet de Touche de 1.

Chaque fois qu’une unité **^^Burrower^^** de votre armée est placée sur le champ de bataille depuis les Réserves, placez un Tunnel Marker circulaire de 40mm n’importe où sur le champ de bataille à 1" ou moins de cette unité et à plus de 3" horizontalement de toutes les unités ennemies.

À l’étape des Renforts de votre phase de Mouvement, lorsque vous placez une unité sur le champ de bataille depuis les Réserves, vous pouvez la placer entièrement à 9" ou moins de l’un de vos Tunnel Markers et à plus de 6" horizontalement de toute unité ennemie.

Si une figurine ennemie (à l’exclusion des **^^Aircraft^^**) termine n’importe quel type de mouvement à 3" ou moins de l’un de vos Tunnel Markers, ce Tunnel Marker est retiré du champ de bataille.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Tyranid Attack" hidden="false" id="0f40-fb6c-49f7-9541">
          <comment>Boarding Actions</comment>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Forming Boarding Squads" id="e207-ef0b-4be5-c91d" hidden="false">
              <description>Les unités suivantes ne sont pas divisées en unités distinctes dans l'étape des escadrons d'embarquement du formulaire:
- ^^**Hormagaunts**^^
- ^^**Neurogaunts**^^
- ^^**Termagants**^^</description>
            </rule>
            <rule name="Mustering A Boarding Patrol" id="72d4-2fdb-7150-b325" hidden="false">
              <description>Vous pouvez inclure jusqu'à deux des unités suivantes:
- **^^Winged Tyranid Prime^^**

Vous pouvez inclure jusqu'à deux des unités suivantes:
- Pour les figurines **^^Tyranid Warriors with Melee Bio-weapons^^** (figurines 3)
- Pour les figurines **^^Tyranid Warriors with Ranged Bio-weapons^^** (figurines 3)

Vous pouvez inclure jusqu'à une des unités suivantes:
- Pour les figurines **^^Hormagaunts^^** (figurines 10)
- Pour les figurines **^^Neurogaunts^^** (figurines 10)
- Pour les figurines **^^Ripper Swarms^^** (figurines 3)
- Pour les figurines **^^Termagants^^** (figurines 10)</description>
            </rule>
            <rule name="Rules Adaptions" id="7a38-f020-b03b-67d3" hidden="false">
              <description>- Les unités **^^Endless Multitude^^** et **^^Ripper Swarms^^** de votre armée sont ignorées dans le but de déterminer la visibilité des figurines **^^Tyranids^^** amicaux qui n'ont pas le mot-clé **^^Endless Multitude^^** ou **^^Ripper Swarms^^**.
- Vous pouvez donner les figurines Tyranid Prime en unités **^^Tyranid Warriors with Melee Bio-weapons^^** et **^^Tyranid Warriors with Ranged Bio-weapons^^** Améliorations comme s'ils étaient des figurines **^^Character^^**.
- Les unités **^^Tyranid Warriors with Melee Bio-weapons^^** et **^^Tyranid Warriors with Ranged Bio-weapons^^** peuvent effectuer la manœuvre tactique du site sécurisé comme s'ils avaient le mot-clé **^^Battleline^^**.
- Les unités **^^Endless Multitude^^** ne peuvent pas effectuer la manœuvre tactique du site sécurisé.
- L’unité **^^Ripper Swarms^^** perd l’aptitude Frappe en profondeur.
- L’unité **^^Termagants^^** perd l’aptitude Skulking Horrors.
- La figurine **^^Winged Tyranid Prime^^** perd l’aptitude Frappe en profondeur.</description>
            </rule>
            <rule name="Xeno-Terror" id="9603-0af4-20ef-dce8" hidden="false">
              <description>Quand vous déchaînez le Shadow in the Warp, Soustrayez 1 du test d’Ébranlement que chaque unité ennemie sur le champ de bataille doit passer. Pour chaque unité ennemie qui échoue à l'un de ces tests, cette unité ennemie ne peut pas faire ce tour.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink targetId="1ce8-4f31-68c3-7bb0" id="11a6-e1aa-1566-3303" type="rule" name="Synaptic Web" hidden="false" />
          </infoLinks>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Boarding Swarm" hidden="false" id="7a6f-7334-fa6c-290e">
          <comment>Boarding Actions</comment>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Forming Boarding Squads" id="e6a7-e5ab-e385-b9ae" hidden="false">
              <description>Ne divisez pas ^^**Hormagaunts**^^ en unités distinctes dans l'étape des escadrons d'embarquement du formulaire.</description>
            </rule>
            <rule name="Mustering A Boarding Patrol" id="76e9-d929-a6d9-68ba" hidden="false">
              <description>Vous pouvez inclure jusqu'à deux des unités suivantes (les duplicats ne sont pas autorisés):
- **^^Deathleaper^^**
- **^^Lictor^^**
- **^^Neurolictor^^**

Vous pouvez inclure jusqu'à deux de chacune des unités suivantes:
- Pour les figurines **^^Hormagaunts^^** (figurines 10)
- Pour les figurines **^^Raveners^^** (figurines 3)
- Pour les figurines **^^Von Ryan's Leaders^^** (figurines 3)</description>
            </rule>
            <rule name="Rules Adaptions" id="0225-ca34-ba14-5d5e" hidden="false">
              <description>- Les unités **^^Hormagaunts^^** ne peuvent pas effectuer la manœuvre tactique du site sécurisé.
- La figurine **^^Lictor^^** perd l’aptitude Pheromone Trail.
- L’unité **^^Raveners^^** perd l’aptitude Death From Below.
- L’unité **^^Von Ryan's Leapers^^** perd l’aptitude Pouncing Leap.</description>
            </rule>
            <rule name="Priority Predation" id="ef72-7adf-ee08-72b0" hidden="false">
              <description>Chaque fois qu'une unité ennemie dans la Portée d’Engagement d'une ou de plusieurs unités **^^Tyranids^^** de votre armée est sélectionnée pour Battre en Retraite, après que l'unité ennemie ait fait ce mouvement Battre en Retraite, pour chacune de ces unités **^^Tyranids^^**, s'il n'y a pas d'autres unités ennemies dans la Portée d’Engagement, elle peut faire un mouvement normal jusqu'à 3".</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink targetId="1ce8-4f31-68c3-7bb0" id="3b57-9700-3d9d-6dc5" type="rule" name="Synaptic Web" hidden="false" />
          </infoLinks>
          <profiles>
            <profile name="Monoform Predators" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ca6f-3978-2524-bd21">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Les figurines **^^Tyranids^^** présentés dans ce détachement ne peuvent pas être améliorés.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Biotide" hidden="false" id="cbfd-453f-6288-6157">
          <comment>Boarding Actions</comment>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="1d6e-2579-8e7f-1ed4" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Forming Boarding Squads" id="7389-af41-7668-ab8e" hidden="false">
              <description>Les unités suivantes ne sont pas divisées en unités distinctes dans l'étape des escadrons d'embarquement du formulaire:
- ^^**Hormagaunts**^^
- ^^**Neurogaunts**^^
- ^^**Termagants**^^</description>
            </rule>
            <rule name="Mustering A Boarding Patrol" id="310c-875f-2ddb-6969" hidden="false">
              <description>Vous pouvez inclure jusqu'à deux des unités suivantes:
- **^^Winged Tyranid Prime^^**

Vous pouvez inclure jusqu'à trois des unités suivantes:
- Pour les figurines **^^Hormagaunts^^** (figurines 10)
- Pour les figurines **^^Neurogaunts^^** (figurines 10)
- Pour les figurines **^^Ripper Swarms^^** (figurines 3)
- Pour les figurines **^^Termagants^^** (figurines 10)</description>
            </rule>
            <rule name="Rules Adaptions" id="38ba-39ef-c45e-1d85" hidden="false">
              <description>- L’unité **^^Ripper Swarms^^** perd l’aptitude Frappe en profondeur.
- L’unité **^^Termagants^^** perd l’aptitude Skulking Horrors.
- La figurine **^^Winged Tyranid Prime^^** perd l’aptitude Frappe en profondeur.</description>
            </rule>
            <rule name="Unstoppable Swarm" id="4523-9912-7f85-abdc" hidden="false">
              <description>Chaque fois qu'une unité **^^Tyranids^^** de votre armée se déplace, les figurines de cette unité peuvent passer par des figurines **^^Tyranids^^** amicaux comme s'ils n'étaient pas là. En outre, chaque fois qu'une unité **^^Tyranids^^** de votre armée tente d'exploiter une Hatchway fermée, si votre adversaire tente de l'empêcher, ajoutez 1 à votre résultat du déploiement.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink targetId="1ce8-4f31-68c3-7bb0" id="bb37-70b8-6f54-2df9" type="rule" name="Synaptic Web" hidden="false" />
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
      <comment>Tyranids</comment>
      <entryLinks>
        <entryLink targetId="24e1-c66e-98e9-135b" id="c2ee-c921-7c5c-ad29" type="selectionEntry" name="Infestation Swarm" hidden="false">
          <comment>Boarding Actions - Great Devourer</comment>
        </entryLink>
      </entryLinks>
