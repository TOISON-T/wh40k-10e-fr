            <characteristic name="SV" typeId="450-a17e-9d5e-29da">3+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">10</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">8+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Aerial Seeding" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ceb3-c557-c854-8883">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">cette figurine doit démarrer la bataille dans les réserves, mais ni lui ni les unités embarquées à l'intérieur ne sont comptées dans les limites imposées au nombre maximal d'unités des réserves avec lesquelles vous pouvez commencer la bataille. cette figurine peut être mis en place à l'étape des Renforts de votre première, deuxième ou troisième phase de Mouvement, indépendamment des règles de la mission. Toutes les unités embarquées dans cette figurine doivent débarquer immédiatement après sa mise en place sur le champ de bataille, et elles doivent être placées à plus de 9" loin de tous les figurines ennemies. Une fois cette figurine installé sur le champ de bataille, aucune unité ne pourra s'y embarquer.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tyrannocyte" typeId="74f8-5443-9d6d-1f1e" typeName="Transport" hidden="false" id="c21b-12cd-b9a6-4e19">
          <characteristics>
            <characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 20 TYRANIDS INFANTRY models, or 1 TYRANIDS MONSTER model with a Wounds characteristic of 12 or less. Each INFANTRY model with a Wounds characteristic of more than 1 takes up the space of 3 models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
