      <profiles>
        <profile id="a4ec-5941-e494-6ed0" name="Alpha Warrior" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Alors que cette figurine mène une unité, les armes équipées de figurines dans cette unité ont la aptitude [Touches soutenues 1].</characteristic>
          </characteristics>
        </profile>
        <profile id="5689-b058-225b-88d9" name="Death Blow" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Si cette figurine est détruit par une attaque de mêlée, s'il n'a pas combattu cette phase, lancez un D6: sur un 4+, ne le retirez pas du jeu. la figurine détruit peut se battre après que l'unité de la figurine attaquant a terminé ses attaques, et est ensuite retiré du jeu.</characteristic>
          </characteristics>
        </profile>
        <profile name="Winged Tyranid Prime" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="6202-88a9-5a3-232a">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">12"</characteristic>
            <characteristic name="T" typeId="d29d-cf75-fc2d-34a4">5</characteristic>
            <characteristic name="SV" typeId="450-a17e-9d5e-29da">4+</characteristic>
            <characteristic name="W" typeId="750a-a2ec-90d3-21fe">6</characteristic>
            <characteristic name="LD" typeId="58d2-b879-49c7-43bc">7+</characteristic>
            <characteristic name="OC" typeId="bef7-942a-1a23-59f8">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Meneur" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="bdac-5b09-9843-5aed">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Cette figurine peut être attachée aux unités suivantes :
- **^^Gargoyles^^**
- **^^Tyranid Warriors With Melee Bio-Weapons^^**
- **^^Tyranid Warriors With Ranged Bio-Weapons^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
