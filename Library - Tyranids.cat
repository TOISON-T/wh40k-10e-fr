          <selectionEntries>
            <selectionEntry id="1173-a18c-18fb-fac9" name="Instinctive Defense" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="71f6-7bf3-d39d-79bf" type="max" />
              </constraints>
              <profiles>
                <profile id="c664-fd7d-1b66-2780" name="Instinctive Defense" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Alors que le porteur se trouve à 6" ou moins d'une ou de plusieurs unités **^^Harvester^^**, vous pouvez cibler l'unité du porteur avec le stratagème d'intervention héroïque pour 0CP. En outre, alors que le porteur se trouve à 6" ou moins d'une ou de plusieurs unités **^^Harvester^^** amicales, les figurines de l'unité du porteur ont la aptitude Fights First.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15" />
              </costs>
            </selectionEntry>
            <selectionEntry id="9785-ca88-1ecd-2d55" name="Parasitic Biomorphology" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="aa15-16fb-2417-ba7" type="max" />
              </constraints>
              <profiles>
                <profile id="68ef-4d8f-7fc-994f" name="Parasitic Biomorphology" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Ajoutez 1 à la caractéristique de Force des armes de mêlée équipées de figurines dans l'unité du porteur. La première fois que l'unité du porteur détruit une unité ennemi en phase de Combat alors que le porteur est à 6" ou moins d'une ou de plusieurs unités **^^Harvester^^**, jusqu'à la fin de la bataille, ajoutez 1 aux caractéristique d’Attaques des armes de mêlée équipées de figurines dans l'unité du porteur.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="25" />
              </costs>
            </selectionEntry>
            <selectionEntry id="9531-2e9e-5137-baff" name="Regenerating Monstrosity" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="9693-cf84-fe69-37a9" type="instanceOf" />
                        <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2e4d-3dd4-3ec4-87e0" type="max" />
              </constraints>
              <profiles>
                <profile id="6b1f-a920-8ec5-c77a" name="Regenerating Monstrosity" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Seul figurine **^^Tyranids^^** (à l'exclusion des figurines **^^Monsters^^**) l’unité du porteur peut être régénérée jusqu'à deux fois par phase, au lieu d'une fois.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="20" />
              </costs>
            </selectionEntry>
            <selectionEntry id="a223-8758-335-7c21" name="Biophagic Flow (Aura)" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7ff1-fc66-d2d5-50b4" type="max" />
              </constraints>
              <profiles>
                <profile id="9211-8584-f894-b756" name="Biophagic Flow (Aura)" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Alors qu'une figurine **^^Harvester^^** convivial se trouve à 12" ou moins du porteur, en utilisant la aptitude Feed the Swarm, cette figurine **^^Harvester^^** peut régénérer une unité **^^Tyranids^^** conviviale qui se trouve à 9" ou moins au lieu d'une unité à 6" ou moins.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="10" />
              </costs>
            </selectionEntry>
          </selectionEntries>
          <comment>Tyranids</comment>
        </selectionEntryGroup>
