          <selectionEntries>
            <selectionEntry id="1b44-a62d-8dcf-c9d9" name="Alien Cunning" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="b051-7c22-14eb-c85d" type="max" />
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="71f6-7bf3-d39d-79bf" type="max" />
              </constraints>
              <profiles>
                <profile id="61a5-80cd-a46-38b5" name="Alien Cunning" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Après que les deux joueurs aient déployé leurs armées, sélectionnez jusqu'à trois unités **^^Tyranids^^** de votre armée et redéployez-les. Si vous le souhaitez, vous pouvez mettre ces unités en réserve stratégique, quel que soit le nombre d'unités déjà en réserve stratégique.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="30" />
              </costs>
            </selectionEntry>
            <selectionEntry id="ae4f-4b00-7733-1cf2" name="Perfectly Adapted" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="b051-7c22-14eb-c85d" type="max" />
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="aa15-16fb-2417-ba7" type="max" />
              </constraints>
              <profiles>
                <profile id="3ffd-af3b-fe75-e013" name="Perfectly Adapted" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Une fois par tour, vous pouvez relancer un jet de Touche, un jet de Blessure, un jet de Dégâts, un jet d’Avance, un jet de Charge ou un jet de sauvegarde fait pour le porteur</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15" />
              </costs>
            </selectionEntry>
            <selectionEntry id="abdd-58fa-44ee-4fa0" name="Synaptic Linchpin" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="b051-7c22-14eb-c85d" type="max" />
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2e4d-3dd4-3ec4-87e0" type="max" />
              </constraints>
              <profiles>
                <profile id="877c-8a93-2907-cf90" name="Synaptic Linchpin" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Alors qu'une unité amicale **^^Tyranids^^** est à 9" ou moins du porteur, cette unité est à l'intérieur de Synapse Portée de votre armée.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="20" />
              </costs>
            </selectionEntry>
            <selectionEntry id="8036-cb7f-d252-2e2a" name="Adaptive Biology" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="d1d8-6ae0-1be7-e9e" type="notInstanceOf" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="b051-7c22-14eb-c85d" type="max" />
                <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7ff1-fc66-d2d5-50b4" type="max" />
              </constraints>
              <profiles>
                <profile id="808c-6c15-dd55-c5b" name="Adaptive Biology" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tyranids^^** figurine uniquement. Le porteur possède la aptitude Insensible à la douleur 5+. Au début de tout tour, si le porteur a moins de PV que son nombre initial restant, jusqu'à la fin de la bataille, il a la aptitude Insensible à la douleur 4+ à la place.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="25" />
              </costs>
            </selectionEntry>
          </selectionEntries>
          <comment>Tyranids</comment>
        </selectionEntryGroup>
        <selectionEntryGroup id="a95f-4bb6-37ad-dae8" name="Assimilation Swarm Enhancements" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
